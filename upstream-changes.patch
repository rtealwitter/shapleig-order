+# Application attributes written as caches by the EIG acquisition path and its
+# incremental (no-refit) updates. A readout on an evaluation-only surrogate
+# must not disturb them, so they are snapshotted and restored around it.
+_EIG_CACHE_ATTRS = (
+    "A_KZW",
+    "AKA",
+    "AEA_unscaled",
+    "A_KZX",
+    "prev_X",
+    "prev_X_binary",
+    "_aka_cache_key_value",
+    "_aka_cache_matrix",
+)
+
+
+def _readout_property_posterior(application, surrogate):
+    """Property posterior from an evaluation-only surrogate.
+
+    The surrogate is fit only to read out the estimate for the metrics trace;
+    its kernel differs from the frozen method surrogate, so every cached
+    quantity the incremental EIG path relies on is protected here.
+    """
+    saved = {
+        a: getattr(application, a)
+        for a in _EIG_CACHE_ATTRS
+        if hasattr(application, a)
+    }
+    try:
+        return application.property_posterior(
+            surrogate, noisy_variant=False, recycle=False
+        )
+    finally:
+        for a in _EIG_CACHE_ATTRS:
+            if a in saved:
+                object.__setattr__(application, a, saved[a])
+            elif hasattr(application, a):
+                object.__delattr__(application, a)
+
+
